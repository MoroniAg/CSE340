<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>

        <% if (projects.length) { %>
            <table>
                <thead>
                    <tr>
                        <% Object.keys(projects[0]).forEach((field) => { %>
                            <th scope="col">
                                <%= field.replaceAll('_', ' ').replace(/\b\w/g, (letter) => letter.toUpperCase()) %>
                            </th>
                        <% }) %>
                    </tr>
                </thead>
                <tbody>
                    <% projects.forEach((project) => { %>
                        <tr>
                            <% Object.values(project).forEach((value) => { %>
                                <td><%= value ?? '' %></td>
                            <% }) %>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        <% } else { %>
            <p>No hay proyectos disponibles.</p>
        <% } %>
    </main>

    <%- include('partials/footer') %>