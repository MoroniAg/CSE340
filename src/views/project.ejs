<%- include('partials/header') %>

    <main>
        <h1>
            <%= project.title %>
        </h1>
        <% if (user && user.role_name === 'admin') { %>
            <a href="/edit-project/<%= project.project_id %>">Edit Project</a>
            <a href="/assign-categories/<%= project.project_id %>">Edit Project Categories</a>
        <% } %>
        <p>
            <%= project.description ?? '' %>
        </p>
        <p><strong>Date:</strong>
            <%= project.date ?? '' %>
        </p>
        <p><strong>Location:</strong>
            <%= project.location ?? '' %>
        </p>
        <p>
            <strong>Partner organization:</strong>
            <a href="/organization/<%= project.organization_id %>">
                <%= project.organization_name %>
            </a>
        </p>
        <h2>Categories for This Project</h2>
        <ul>
            <% categories.forEach((category)=> { %>
                <li><a href="/category/<%= category.category_id %>">
                        <%= category.category_name %>
                    </a></li>
                <% }); %>
        </ul>
    </main>

    <%- include('partials/footer') %>