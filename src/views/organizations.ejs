<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>

        <p>Here are our partner organizations:</p>
        <ul>
            <% if (organizations.length) { %>
                <% organizations.forEach(organization => { %>
                    <li>
                        <img src="/images/<%= organization.logo_filename %>" alt="<%= organization.name %> logo">
                        <strong><%= organization.name %></strong>: <%= organization.contact_email %>
                    </li>
                <% }); %>
            <% } else { %>
                <li>No partner organizations found.</li>
            <% } %>
        </ul>
    </main>

    <%- include('partials/footer') %>